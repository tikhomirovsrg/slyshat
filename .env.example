# Для сервера: https://english.example.com (без пути).
# Для локальной проверки: http://localhost:3000
APP_URL=http://localhost:3000
LOCAL_PORT=3000

# Создайте приложение для авторизации: https://oauth.yandex.ru/client/new/id/
# Redirect URI: <APP_URL>/api/auth/yandex/callback
# Единственное необходимое право: login:info
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Необязательно: разрешённые логины Яндекса через запятую, например sergey,anna.
# Пусто = любой пользователь Яндекса может создать свой отдельный профиль.
YANDEX_ALLOWED_LOGINS=

# Нейроозвучка: device = системные голоса, google = Google Chirp 3 HD.
# Ключ Cloud Text-to-Speech (не Gemini) хранится только на сервере.
# Инструкция: docs/AUDIO.md
TTS_PROVIDER=device
GOOGLE_TTS_API_KEY=
# Общий лимит символов новых записей в сутки UTC, 0 = только готовый кэш.
TTS_DAILY_CHAR_LIMIT=20000
