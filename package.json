{
  "name": "slyshat",
  "version": "3.3.0",
  "private": true,
  "scripts": {
    "content:build": "node scripts/build-content.cjs",
    "db:migrate": "node scripts/migrate.mjs",
    "prebuild": "node scripts/build-content.cjs && npm run audio:validate && npm run course:validate && npm run comics:validate && npm run characters:validate && npm run character-audio:check",
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "check": "tsc --noEmit",
    "test": "node scripts/check-learning.cjs && node --test tests/*.cjs",
    "test:production": "node scripts/check-production.cjs",
    "audio:validate": "node scripts/audio-library/validate.cjs",
    "comics:validate": "node scripts/comics/validate.cjs",
    "course:validate": "node scripts/story-course/validate.cjs",
    "characters:validate": "node scripts/characters/validate.cjs",
    "character-audio:validate": "node scripts/character-audio/validate.cjs",
    "character-audio:check": "node scripts/character-audio/validate.cjs --if-present"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "1.31.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3"
  }
}
